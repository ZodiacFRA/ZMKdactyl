#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define QWERTY 0
#define FN 1
#define GAMING 2

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp DEL
                &kp TAB    &kp A     &kp Z     &kp E     &kp R     &kp T                 &kp Y     &kp U     &kp I     &kp O     &kp P     &kp EQUAL
                &kp LSHFT  &kp Q     &kp S     &kp D     &kp F     &kp G                 &kp H     &kp J     &kp K     &kp L     &kp M     &kp MINUS
                &kp LCTRL  &kp GRAVE &kp W     &kp X     &kp C     &kp V                 &kp B     &kp N     &kp COMMA &kp DOT   &kp FSLH  &kp SEMI
                                      &kp BSLS &kp SQT                                             &kp LBKT  &kp RBKT
                                                       &kp LGUI &kp LALT                 &kp BSPC  &lt FN ENTER
                                                       &trans   &kp SPACE                &kp SPACE &kp A
                                                       &trans   &trans                   &kp B     &kp C
            >;
        };

        fn_layer {
            bindings = <
                &trans   &kp F1   &kp F2    &kp F3   &kp F4    &kp F5                  &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
                &kp CAPS &kp VOLU &kp HOME  &kp UP   &kp END   &kp PGUP                &kp MNXT  &kp HOME  &kp UP    &kp END   &trans    &kp F12
                &trans   &kp VOLD &kp LEFT  &kp DOWN &kp RIGHT &kp PGDN                &kp MPRV  &kp LEFT  &kp DOWN  &kp RIGHT &trans    &trans
                &trans   &kp MUTE &trans    &trans   &trans    &trans                  &kp MPLY  &trans    &trans    &trans    &trans    &tog GAMING
                                      &reset &trans                                                 &trans   &reset
                                                    &kp LGUI &kp LALT                  &kp BSPC  &lt FN ENTER
                                                    &trans   &kp SPACE                 &kp SPACE &kp A
                                                    &trans   &trans                    &kp B     &kp C
            >;
        };

        gaming_layer {
            bindings = <
                &kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5                &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp DEL
                &kp TAB    &kp T     &kp Z     &kp W     &kp R     &kp F                 &kp Y     &kp U     &kp I     &kp O     &kp P     &kp EQUAL
                &kp LSHFT  &kp Q     &kp A     &kp S     &kp D     &kp G                 &kp H     &kp J     &kp K     &kp L     &kp M     &kp MINUS
                &kp LCTRL  &kp GRAVE &kp LALT  &kp X     &kp C     &kp V                 &kp B     &kp N     &kp COMMA &kp DOT   &kp FSLH  &tog GAMING
                                      &kp BSLS &kp SQT                                               &kp LBKT  &kp RBKT
                                                        &kp LGUI &kp E                 &kp BSPC  &lt FN ENTER
                                                        &trans   &kp SPACE             &kp SPACE &kp A
                                                        &trans   &trans                &kp B     &kp C
            >;
        };
    };
};
